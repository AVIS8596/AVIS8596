# ========== 复制本文件为 .env 后填写，然后执行：chmod 600 .env ==========
# 注意：.env 里有私钥，绝不要发给任何人、不要上传到 GitHub。

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- GMGN（数据 + 下单）----
GMGN_API_KEY=
# 申请 API 时生成的 Ed25519 私钥文件路径（推荐），例如 gmgn_private.pem
GMGN_PRIVATE_KEY_FILE=gmgn_private.pem
# 或者直接把 PEM 内容写在一行里，换行用 \n 代替（和上面二选一）
GMGN_PRIVATE_KEY=
# 绑定在 GMGN API Key 上的钱包地址（下单从这个钱包出钱）
GMGN_WALLET_SOL=
GMGN_WALLET_EVM=

# ---- Solana 节点（实时监听聪明钱用）----
HELIUS_API_KEY=
# 备用 Solana 节点（Chainstack / Alchemy / QuickNode 后台复制 HTTPS 地址），多个用逗号隔开。
# 排在前面的额度用完会自动换下一个；有 HELIUS_API_KEY 时 Helius 排第一。用 python3 deploy/setup_env.py solana 填写
SOLANA_RPC_URLS=

# ---- 可选：备用数据源（config.yaml 里 data.provider: birdeye 时才需要）----
BIRDEYE_API_KEY=
# 可选：EVM 链资金溯源（查捆绑地址的出资人）。BSC/Base 需要 Etherscan Lite 及以上付费档
ETHERSCAN_API_KEY=

# ---- EVM 链节点（ETH / BSC / Base，实时监听聪明钱用）----
# 每条链一个 HTTPS 和一个 WSS 节点地址（QuickNode / Alchemy 后台复制）
ETH_RPC_HTTP=
ETH_RPC_WSS=
BSC_RPC_HTTP=
BSC_RPC_WSS=
BASE_RPC_HTTP=
BASE_RPC_WSS=

# ---- 可选：自托管下单（config.yaml 里 trading.executor: self 时才需要）----
JUPITER_API_KEY=
ZEROX_API_KEY=
SOLANA_PRIVATE_KEY=
EVM_PRIVATE_KEY=
